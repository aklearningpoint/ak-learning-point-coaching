function getSpreadsheet() {
  return SpreadsheetApp.getActiveSpreadsheet();
}

// RUN THIS FUNCTION ONCE TO CREATE ALL TABS AUTOMATICALLY
function initialSheetSetup() {
  var ss = getSpreadsheet();
  
  var sheets = {
    "Quizzes": ["Quiz_ID", "Title", "Board", "Class", "Subject", "Timer_Type", "Timer_Value", "Negative_Mark", "Is_Rewarding", "Passkey", "Status", "Created_At"],
    "Questions": ["Question_ID", "Quiz_ID", "Question_Text", "Opt_A", "Opt_B", "Opt_C", "Opt_D", "Correct_Option"],
    "Attempts": ["Attempt_ID", "Quiz_ID", "Quiz_Title", "Student_Name", "Mobile", "Score", "Total_Marks", "Percentage", "Answers_JSON", "Timestamp"],
    "Students_Ledger": ["Student_ID", "Name", "Mobile", "Class", "Category", "Monthly_Fee", "Dues", "Last_Payment_Date", "Pin", "Timestamp"],
    "School_Students": ["Class", "Roll_No", "Name", "Father_Name", "Mother_Name", "Mobile", "Address"],
    "School_Marks": ["Class", "Term", "Roll_No", "Subject", "Marks_Obtained"],
    "Materials": ["Material_ID", "Title", "Class", "Subject", "Type", "URL", "Content", "Date", "Timestamp"],
    "Notifications": ["Notification_ID", "Title", "Target_Class", "Message", "Posted_By", "Date", "Timestamp"]
  };

  for (var sheetName in sheets) {
    var sheet = ss.getSheetByName(sheetName);
    if (!sheet) {
      sheet = ss.insertSheet(sheetName);
      sheet.appendRow(sheets[sheetName]);
      sheet.getRange(1, 1, 1, sheets[sheetName].length).setFontWeight("bold").setBackground("#141e37").setFontColor("#ffffff");
    }
  }
  return "All Database Tabs Created Successfully!";
}

function doGet(e) {
  var action = (e && e.parameter) ? e.parameter.action : "";
  var tabName = (e && e.parameter) ? e.parameter.tabName : "";
  var ss = getSpreadsheet();
  var result = { status: "success", data: [] };

  // 1. Quizzes fetch
  if (action === "getQuizzes" || action === "getAllQuizzes" || action === "getLiveQuizzes") {
    var qSheet = ss.getSheetByName("Quizzes");
    var quesSheet = ss.getSheetByName("Questions");
    if (!qSheet) return returnJSON(result);

    var qData = qSheet.getDataRange().getValues();
    var questionsData = quesSheet ? quesSheet.getDataRange().getValues() : [];
    var list = [];

    for (var i = 1; i < qData.length; i++) {
      var qId = qData[i][0];
      var questions = [];
      for (var j = 1; j < questionsData.length; j++) {
        if (questionsData[j][1] === qId) {
          questions.push({
            question: questionsData[j][2],
            options: [questionsData[j][3], questionsData[j][4], questionsData[j][5], questionsData[j][6]],
            correctAnswer: parseInt(questionsData[j][7])
          });
        }
      }

      list.push({
        id: qId,
        title: qData[i][1],
        board: qData[i][2],
        className: qData[i][3],
        subject: qData[i][4],
        timerType: qData[i][5],
        timerValue: qData[i][6],
        negativeMarking: qData[i][7],
        isRewarding: qData[i][8],
        passkey: qData[i][9],
        status: qData[i][10],
        questions: questions
      });
    }
    result.data = list;
    return returnJSON(result);
  }

  // 2. Attempts / Leaderboard fetch
  if (action === "getAttempts" || action === "getLeaderboard" || action === "getStudentResults" || tabName === "Attempts") {
    var attSheet = ss.getSheetByName("Attempts");
    if (!attSheet) return returnJSON(result);

    var attData = attSheet.getDataRange().getValues();
    if (attData.length <= 1) return returnJSON(result);

    var headers = attData[0];
    var attemptsList = [];

    for (var r = 1; r < attData.length; r++) {
      var row = attData[r];
      var rowObj = {};
      for (var c = 0; c < headers.length; c++) {
        rowObj[headers[c]] = row[c];
      }
      attemptsList.push(rowObj);
    }

    result.data = attemptsList;
    return returnJSON(result);
  }

  // 3. Live Notifications Fetch (For Student Bell & Teacher/Admin Views)
  if (action === "getNotifications") {
    var notifSheet = ss.getSheetByName("Notifications");
    if (!notifSheet) return returnJSON(result);

    var notifData = notifSheet.getDataRange().getValues();
    if (notifData.length <= 1) return returnJSON(result);

    var notifs = [];
    for (var n = notifData.length - 1; n >= 1; n--) { // Latest on top
      notifs.push({
        id: notifData[n][0],
        title: notifData[n][1],
        targetClass: notifData[n][2],
        message: notifData[n][3],
        postedBy: notifData[n][4],
        date: notifData[n][5],
        timestamp: notifData[n][6]
      });
    }
    result.data = notifs;
    return returnJSON(result);
  }

  // 4. Student Ledger & Classification Fetch
  if (action === "getStudentsLedger") {
    var sSheet = ss.getSheetByName("Students_Ledger");
    if (!sSheet) return returnJSON(result);

    var sData = sSheet.getDataRange().getValues();
    if (sData.length <= 1) return returnJSON(result);

    var students = [];
    for (var s = 1; s < sData.length; s++) {
      students.push({
        id: sData[s][0],
        name: sData[s][1],
        mobile: sData[s][2],
        className: sData[s][3],
        category: sData[s][4],
        monthlyFee: sData[s][5],
        dues: sData[s][6],
        lastPaymentDate: sData[s][7],
        pin: sData[s][8],
        timestamp: sData[s][9]
      });
    }
    result.data = students;
    return returnJSON(result);
  }

  return returnJSON(result);
}

function doPost(e) {
  var ss = getSpreadsheet();
  var result = { status: "success" };

  try {
    var rawContents = (e && e.postData && e.postData.contents) ? e.postData.contents : "{}";
    var data = JSON.parse(rawContents);
    var action = (e && e.parameter && e.parameter.action) ? e.parameter.action : (data.action || "");

    // 1. SAVE NEW QUIZ & QUESTIONS
    if (action === "saveQuiz" || data.action === "saveQuiz" || data.questions) {
      var qSheet = ss.getSheetByName("Quizzes");
      var quesSheet = ss.getSheetByName("Questions");

      if (!qSheet) {
        qSheet = ss.insertSheet("Quizzes");
        qSheet.appendRow(["Quiz_ID", "Title", "Board", "Class", "Subject", "Timer_Type", "Timer_Value", "Negative_Marking", "Is_Rewarding", "Passkey", "Status", "Created_At"]);
      }
      if (!quesSheet) {
        quesSheet = ss.insertSheet("Questions");
        quesSheet.appendRow(["Question_ID", "Quiz_ID", "Question_Text", "Option_A", "Option_B", "Option_C", "Option_D", "Correct_Answer_Index"]);
      }

      var qz = data.quiz || data;
      var qId = qz.id || ("qz_" + Date.now());

      qSheet.appendRow([
        qId,
        qz.title || "Untitled Quiz",
        qz.board || "CBSE",
        qz.className || "",
        qz.subject || "",
        qz.timerType || "full",
        qz.timerValue || 15,
        qz.negativeMarking || 0,
        qz.isRewarding ? true : false,
        qz.passkey || "",
        qz.status || "published",
        new Date().toISOString()
      ]);

      if (qz.questions && Array.isArray(qz.questions)) {
        for (var i = 0; i < qz.questions.length; i++) {
          var item = qz.questions[i];
          var opts = item.options || [];
          quesSheet.appendRow([
            "ques_" + Date.now() + "_" + i,
            qId,
            item.question || "",
            opts[0] || "",
            opts[1] || "",
            opts[2] || "",
            opts[3] || "",
            item.correctAnswer !== undefined ? item.correctAnswer : 0
          ]);
        }
      }

      result.message = "Quiz & Questions saved successfully";
      result.id = qId;
      return returnJSON(result);
    }

    // 2. SAVE STUDY MATERIAL
    if (action === "saveMaterial" || data.action === "saveMaterial") {
      var matSheet = ss.getSheetByName("Materials");
      if (!matSheet) {
        matSheet = ss.insertSheet("Materials");
        matSheet.appendRow(["Material_ID", "Title", "Class", "Subject", "Type", "URL", "Content", "Date", "Timestamp"]);
      }

      var m = data.material || data;
      matSheet.appendRow([
        m.id || ("mat_" + Date.now()),
        m.title || "",
        m.className || "",
        m.subject || "",
        m.type || "",
        m.url || "",
        m.content || m.desc || "",
        m.date || new Date().toLocaleDateString("en-GB"),
        m.timestamp || new Date().toISOString()
      ]);

      result.message = "Material saved successfully";
      return returnJSON(result);
    }

    // 3. SAVE LIVE NOTIFICATION (NEW)
    if (action === "saveNotification" || data.action === "saveNotification") {
      var notifSheet = ss.getSheetByName("Notifications");
      if (!notifSheet) {
        notifSheet = ss.insertSheet("Notifications");
        notifSheet.appendRow(["Notification_ID", "Title", "Target_Class", "Message", "Posted_By", "Date", "Timestamp"]);
      }

      var n = data.notification || data;
      notifSheet.appendRow([
        n.id || ("notif_" + Date.now()),
        n.title || "",
        n.targetClass || "All Classes",
        n.message || "",
        n.postedBy || "Faculty/Admin",
        n.date || new Date().toLocaleDateString("en-GB"),
        n.timestamp || new Date().toISOString()
      ]);

      result.message = "Notification saved to sheet successfully";
      return returnJSON(result);
    }

    // 4. SAVE / UPDATE STUDENT IN LEDGER & CLASSIFICATION (NEW)
    if (action === "saveStudentLedger" || data.action === "saveStudentLedger") {
      var ledgerSheet = ss.getSheetByName("Students_Ledger");
      if (!ledgerSheet) {
        ledgerSheet = ss.insertSheet("Students_Ledger");
        ledgerSheet.appendRow(["Student_ID", "Name", "Mobile", "Class", "Category", "Monthly_Fee", "Dues", "Last_Payment_Date", "Pin", "Timestamp"]);
      }

      var st = data.student || data;
      var stMobile = String(st.mobile || "").trim();
      var dataVals = ledgerSheet.getDataRange().getValues();
      var existingRowIndex = -1;

      // Agar student already exists karta hai to usi row ko update karo, nahi to new row add karo
      for (var r = 1; r < dataVals.length; r++) {
        if (String(dataVals[r][2]).trim() === stMobile) {
          existingRowIndex = r + 1;
          break;
        }
      }

      var rowValues = [
        st.id || ("st_" + Date.now()),
        st.name || "",
        st.mobile || "",
        st.className || "",
        st.category || "Guest Student",
        st.monthlyFee || 0,
        st.dues || 0,
        st.lastPaymentDate || "",
        st.pin || "1234",
        new Date().toISOString()
      ];

      if (existingRowIndex > -1) {
        ledgerSheet.getRange(existingRowIndex, 1, 1, rowValues.length).setValues([rowValues]);
        result.message = "Student record updated in Sheet";
      } else {
        ledgerSheet.appendRow(rowValues);
        result.message = "New Student saved to Sheet";
      }

      return returnJSON(result);
    }

    // 5. SAVE STUDENT ATTEMPT
    if (action === "submitQuizAttempt" || action === "saveAttempt" || data.action === "submitQuizAttempt" || data.action === "saveAttempt") {
      var attSheet = ss.getSheetByName("Attempts");
      if (!attSheet) {
        attSheet = ss.insertSheet("Attempts");
        attSheet.appendRow(["Attempt_ID", "Quiz_ID", "Quiz_Title", "Student_Name", "Mobile", "Score", "Total_Marks", "Percentage", "Answers_JSON", "Timestamp"]);
      }

      var att = data.attempt || data;
      var attemptId = att.attemptId || att.id || ("att_" + Date.now());
      var quizId = att.quizId || "";
      var quizTitle = att.quizTitle || "";
      var studentName = att.studentName || att.name || "Student";
      var mobile = att.mobile || "";
      var score = att.score !== undefined ? att.score : 0;
      var totalMarks = att.totalMarks || att.total || 0;
      var percentage = att.percentage !== undefined ? att.percentage : (totalMarks > 0 ? ((score / totalMarks) * 100).toFixed(1) : 0);
      var answersJson = typeof att.answers === "object" ? JSON.stringify(att.answers) : (att.answers || "{}");

      var lastRow = attSheet.getLastRow();
      var isDuplicate = false;
      if (lastRow > 1) {
        var startRow = Math.max(2, lastRow - 5);
        var numRows = (lastRow - startRow) + 1;
        var lastValues = attSheet.getRange(startRow, 1, numRows, 10).getValues();
        for (var k = 0; k < lastValues.length; k++) {
          var prevRow = lastValues[k];
          if (String(prevRow[1]) === String(quizId) && String(prevRow[3]).trim().toLowerCase() === String(studentName).trim().toLowerCase()) {
            var prevTime = new Date(prevRow[9]).getTime();
            if (Date.now() - prevTime < 15000) {
              isDuplicate = true;
              break;
            }
          }
        }
      }

      if (!isDuplicate) {
        attSheet.appendRow([
          attemptId,
          quizId,
          quizTitle,
          studentName,
          mobile,
          score,
          totalMarks,
          percentage,
          answersJson,
          new Date().toISOString()
        ]);
        result.message = "Attempt saved successfully";
      } else {
        result.message = "Duplicate attempt ignored";
      }

      return returnJSON(result);
    }

  } catch (err) {
    result.status = "error";
    result.message = err.toString();
  }

  return returnJSON(result);
}

function returnJSON(obj) {
  return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON);
}
