function getSpreadsheet() {
  return SpreadsheetApp.getActiveSpreadsheet();
}

// 1. RUN THIS ONCE TO CREATE / FIX COACHING TABS & HEADERS
function initialSheetSetup() {
  var ss = getSpreadsheet();
  
  var sheets = {
    "Quizzes": ["Quiz_ID", "Title", "Board", "Class", "Subject", "Timer_Type", "Timer_Value", "Negative_Mark", "Is_Rewarding", "Passkey", "Status", "Created_At"],
    "Questions": ["Question_ID", "Quiz_ID", "Question_Text", "Opt_A", "Opt_B", "Opt_C", "Opt_D", "Correct_Option"],
    "Attempts": ["Attempt_ID", "Quiz_ID", "Quiz_Title", "Student_Name", "Mobile", "Score", "Total_Marks", "Percentage", "Answers_JSON", "Timestamp"],
    
    // Exact standard column mapping for Students_Ledger
    "Students_Ledger": [
      "Student_ID",        // Col A: stu_...
      "Name",              // Col B: Student Name
      "Mobile",            // Col C: 10-Digit Mobile Number
      "Class",             // Col D: Class 9, Class 10 etc.
      "Category",          // Col E: Tuition Student / Regular
      "Monthly_Fee",       // Col F: Fee Amount (Number)
      "Start_Date",        // Col G: Joining / Cycle Start Date (YYYY-MM-DD)
      "Paid_History_JSON", // Col H: Array of completed cycles & receipts
      "Dues",              // Col I: Pending balance amount
      "Timestamp"          // Col J: Last updated ISO timestamp
    ],
    
    "Materials": ["Material_ID", "Title", "Class", "Subject", "Type", "URL", "Content", "Date", "Timestamp"],
    "Notifications": ["Notification_ID", "Title", "Target_Class", "Message", "Posted_By", "Date", "Timestamp"],
    "Student_Profiles": ["Timestamp", "Mobile", "Student_Name", "Class", "Board", "Category", "Registered_Date"]
  };

  for (var sheetName in sheets) {
    var sheet = ss.getSheetByName(sheetName);
    var headers = sheets[sheetName];
    if (!sheet) {
      sheet = ss.insertSheet(sheetName);
    }
    // Set headers & styling
    sheet.getRange(1, 1, 1, headers.length).setValues([headers]);
    sheet.getRange(1, 1, 1, headers.length)
      .setFontWeight("bold")
      .setBackground("#141e37")
      .setFontColor("#ffffff");
    sheet.setFrozenRows(1);
  }
  return "All Database Tabs Created and Synchronized Successfully!";
}

// =========================================================================
// 2. DOGET: LIVE DATA FETCHING & AUTO-BILLING ENGINE
// =========================================================================
function doGet(e) {
  var action = (e && e.parameter) ? e.parameter.action : "";
  var ss = getSpreadsheet();
  var result = { status: "success", data: [] };

  // A. QUIZZES FETCH
  if (action === "getQuizzes" || action === "getAllQuizzes" || action === "getLiveQuizzes") {
    var qSheet = ss.getSheetByName("Quizzes");
    var quesSheet = ss.getSheetByName("Questions");
    if (!qSheet) return returnJSON(result);

    var qData = qSheet.getDataRange().getValues();
    var questionsData = quesSheet ? quesSheet.getDataRange().getValues() : [];
    var list = [];

    for (var i = 1; i < qData.length; i++) {
      var qId = qData[i][0];
      var questions = [];
      for (var j = 1; j < questionsData.length; j++) {
        if (String(questionsData[j][1]).trim() === String(qId).trim()) {
          questions.push({
            question: questionsData[j][2],
            options: [questionsData[j][3], questionsData[j][4], questionsData[j][5], questionsData[j][6]],
            correctAnswer: parseInt(questionsData[j][7])
          });
        }
      }

      list.push({
        id: qId,
        title: qData[i][1],
        board: qData[i][2],
        className: qData[i][3],
        subject: qData[i][4],
        timerType: qData[i][5],
        timerValue: qData[i][6],
        negativeMarking: qData[i][7],
        isRewarding: qData[i][8],
        passkey: qData[i][9],
        status: qData[i][10],
        questions: questions
      });
    }
    result.data = list;
    return returnJSON(result);
  }

  // B. ATTEMPTS & RESULTS FETCH
  if (action === "getAttempts" || action === "getLeaderboard" || action === "getStudentResults") {
    var attSheet = ss.getSheetByName("Attempts");
    if (!attSheet) return returnJSON(result);
    result.data = getSheetDataAsObjects(attSheet);
    return returnJSON(result);
  }

  // C. LIVE NOTIFICATIONS FETCH
  if (action === "getNotifications") {
    var notifSheet = ss.getSheetByName("Notifications");
    if (!notifSheet) return returnJSON(result);
    var notifs = getSheetDataAsObjects(notifSheet);
    notifs.reverse(); // Newest first
    result.data = notifs;
    return returnJSON(result);
  }

  // D. STUDY MATERIALS FETCH
  if (action === "getMaterials") {
    var matSheet = ss.getSheetByName("Materials");
    if (!matSheet) return returnJSON(result);
    var mats = getSheetDataAsObjects(matSheet);
    mats.reverse();
    result.data = mats;
    return returnJSON(result);
  }

  // E. STUDENTS LEDGER (WITH ACCURATE MONTH-TO-MONTH BILLING CYCLE)
  if (action === "getLedger" || action === "getStudentsLedger") {
    var sSheet = ss.getSheetByName("Students_Ledger");
    if (!sSheet) return returnJSON(result);
    
    var rawLedger = getSheetDataAsObjects(sSheet);
    var processedStudents = rawLedger.map(function(student) {
      return processStudentBillingCycles(student);
    });

    result.data = processedStudents;
    return returnJSON(result);
  }

  // F. STUDENT PROFILES FETCH
  if (action === "getStudentProfiles") {
    var profSheet = ss.getSheetByName("Student_Profiles");
    if (!profSheet) return returnJSON(result);
    result.data = getSheetDataAsObjects(profSheet);
    return returnJSON(result);
  }

  return returnJSON(result);
}

// =========================================================================
// 3. DOPOST: SAVE & UPDATE ENGINE
// =========================================================================
function doPost(e) {
  var ss = getSpreadsheet();
  var result = { status: "success" };

  try {
    var rawContents = (e && e.postData && e.postData.contents) ? e.postData.contents : "{}";
    var data = JSON.parse(rawContents);
    var action = (e && e.parameter && e.parameter.action) ? e.parameter.action : (data.action || "");

    // 1. SAVE NEW QUIZ & QUESTIONS
    if (action === "saveQuiz" || data.questions) {
      var qSheet = ss.getSheetByName("Quizzes");
      var quesSheet = ss.getSheetByName("Questions");
      var qz = data.quiz || data;
      var qId = qz.id || ("qz_" + Date.now());

      qSheet.appendRow([
        qId,
        qz.title || "Untitled Quiz",
        qz.board || "CBSE",
        qz.className || "",
        qz.subject || "",
        qz.timerType || "full",
        qz.timerValue || 15,
        qz.negativeMarking || 0,
        qz.isRewarding ? true : false,
        qz.passkey || "",
        qz.status || "published",
        new Date().toISOString()
      ]);

      if (qz.questions && Array.isArray(qz.questions)) {
        for (var i = 0; i < qz.questions.length; i++) {
          var item = qz.questions[i];
          var opts = item.options || [];
          quesSheet.appendRow([
            "ques_" + Date.now() + "_" + i,
            qId,
            item.question || "",
            opts[0] || "",
            opts[1] || "",
            opts[2] || "",
            opts[3] || "",
            item.correctAnswer !== undefined ? item.correctAnswer : 0
          ]);
        }
      }

      result.message = "Quiz & Questions saved successfully";
      result.id = qId;
      return returnJSON(result);
    }

    // 2. SAVE STUDY MATERIAL
    if (action === "saveMaterial") {
      var matSheet = ss.getSheetByName("Materials");
      var m = data.material || data;
      matSheet.appendRow([
        m.id || ("mat_" + Date.now()),
        m.title || "",
        m.className || "",
        m.subject || "",
        m.type || "PDF",
        m.url || "",
        m.content || m.desc || "",
        m.date || new Date().toLocaleDateString("en-GB"),
        new Date().toISOString()
      ]);
      result.message = "Material saved successfully";
      return returnJSON(result);
    }

    // 3. SAVE NOTIFICATION (BROADCAST)
    if (action === "saveNotification") {
      var notifSheet = ss.getSheetByName("Notifications");
      var n = data.notification || data;
      notifSheet.appendRow([
        n.id || ("notif_" + Date.now()),
        n.title || "",
        n.targetClass || "All Classes",
        n.message || "",
        n.postedBy || "Faculty/Admin",
        n.date || new Date().toLocaleDateString("en-GB"),
        new Date().toISOString()
      ]);
      result.message = "Notification saved to sheet";
      return returnJSON(result);
    }

    // 4. SAVE / UPDATE STUDENT IN LEDGER
    if (action === "saveStudentLedger") {
      var ledgerSheet = ss.getSheetByName("Students_Ledger");
      var st = data.student || data;
      var stMobile = String(st.mobile || "").trim();
      var dataVals = ledgerSheet.getDataRange().getValues();
      var existingRowIndex = -1;

      for (var r = 1; r < dataVals.length; r++) {
        if (String(dataVals[r][2]).trim() === stMobile) {
          existingRowIndex = r + 1;
          break;
        }
      }

      var rowValues = [
        st.id || ("stu_" + Date.now()),
        st.name || "",
        stMobile,
        st.className || "",
        st.category || "Tuition Student",
        Number(st.monthlyFee || 1300),
        st.startDate || new Date().toISOString().split("T")[0],
        typeof st.paidHistory === "object" ? JSON.stringify(st.paidHistory) : (st.paidHistory || "[]"),
        Number(st.dues || 0),
        new Date().toISOString()
      ];

      if (existingRowIndex > -1) {
        ledgerSheet.getRange(existingRowIndex, 1, 1, rowValues.length).setValues([rowValues]);
        result.message = "Student record updated in Sheet";
      } else {
        ledgerSheet.appendRow(rowValues);
        result.message = "New Student created in Sheet";
      }
      return returnJSON(result);
    }

    // 5. REGISTER STUDENT PROFILE
    if (action === "registerStudentProfile") {
      var profSheet = ss.getSheetByName("Student_Profiles");
      var prof = data.profile || data;
      profSheet.appendRow([
        new Date().toISOString(),
        String(prof.mobile || "").trim(),
        prof.name || "Student",
        prof.className || "Class 10",
        prof.board || "CBSE",
        prof.category || "Tuition Student",
        new Date().toLocaleDateString("en-GB")
      ]);
      result.message = "Student profile saved in Sheet";
      return returnJSON(result);
    }

    // 6. SUBMIT PAYMENT PROOF & LOG PAYMENT ENTRY
    if (action === "uploadPaymentReceipt") {
      var ledgerSheet = ss.getSheetByName("Students_Ledger");
      var mob = String(data.studentMobile || "").trim();
      var dataVals = ledgerSheet.getDataRange().getValues();

      for (var r = 1; r < dataVals.length; r++) {
        if (String(dataVals[r][2]).trim() === mob) {
          var history = [];
          try {
            history = JSON.parse(dataVals[r][7] || "[]");
          } catch(err) { history = []; }

          history.push({
            date: new Date().toLocaleDateString("en-GB"),
            amount: Number(dataVals[r][5] || 1300),
            note: "Online Payment Uploaded",
            timestamp: new Date().toISOString()
          });

          ledgerSheet.getRange(r + 1, 8).setValue(JSON.stringify(history));
          ledgerSheet.getRange(r + 1, 9).setValue(0); // Clear current due
          break;
        }
      }
      result.message = "Receipt logged successfully";
      return returnJSON(result);
    }

    // 7. SUBMIT QUIZ ATTEMPT (WITH ANTI-DUPLICATE GUARD)
    if (action === "submitQuizAttempt" || action === "saveAttempt") {
      var attSheet = ss.getSheetByName("Attempts");
      var att = data.attempt || data;
      var qId = att.quizId || "";
      var sName = att.studentName || att.name || "Student";
      var sMob = att.mobile || "";

      var score = Number(att.score !== undefined ? att.score : 0);
      var totalMarks = Number(att.totalMarks || att.total || 0);
      var percentage = totalMarks > 0 ? ((score / totalMarks) * 100).toFixed(1) : 0;
      var answersJson = typeof att.answers === "object" ? JSON.stringify(att.answers) : (att.answers || "{}");

      attSheet.appendRow([
        att.attemptId || ("att_" + Date.now()),
        qId,
        att.quizTitle || "Exam",
        sName,
        sMob,
        score,
        totalMarks,
        percentage,
        answersJson,
        new Date().toISOString()
      ]);

      result.message = "Attempt saved successfully";
      return returnJSON(result);
    }

  } catch (err) {
    result.status = "error";
    result.message = err.toString();
  }

  return returnJSON(result);
}

// =========================================================================
// 4. MONTH-BY-MONTH BILLING CYCLE HELPER
// =========================================================================
function processStudentBillingCycles(student) {
  var fee = Number(student.Monthly_Fee || 1300);
  var rawDate = student.Start_Date || student.Timestamp || "2026-10-30";
  var startDate = new Date(rawDate);
  if (isNaN(startDate.getTime())) startDate = new Date("2026-10-30");

  var today = new Date();

  // Full calendar months elapsed calculation
  var elapsedMonths = (today.getFullYear() - startDate.getFullYear()) * 12 + (today.getMonth() - startDate.getMonth());
  if (today.getDate() < startDate.getDate()) {
    elapsedMonths--; // Current cycle is still running
  }
  elapsedMonths = Math.max(0, elapsedMonths);

  var totalCyclesCount = elapsedMonths + 1; // Including active cycle

  var paidHistory = [];
  try {
    paidHistory = JSON.parse(student.Paid_History_JSON || "[]");
  } catch(e) { paidHistory = []; }

  var totalPaid = 0;
  paidHistory.forEach(function(item) {
    totalPaid += Number(item.amount || 0);
  });

  var totalBilled = totalCyclesCount * fee;
  var currentDues = Math.max(0, totalBilled - totalPaid);

  var cycleStart = new Date(startDate);
  cycleStart.setMonth(cycleStart.getMonth() + elapsedMonths);

  var cycleEnd = new Date(cycleStart);
  cycleEnd.setMonth(cycleEnd.getMonth() + 1);

  student.calculatedDues = currentDues;
  student.currentCycleText = formatDateDM(cycleStart) + " to " + formatDateDM(cycleEnd);
  student.nextBillingDate = cycleEnd.toLocaleDateString("en-IN", { day: '2-digit', month: 'short', year: 'numeric' });
  student.parsedPaidHistory = paidHistory;

  return student;
}

function formatDateDM(d) {
  var months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
  return d.getDate() + " " + months[d.getMonth()];
}

// Universal Sheet-to-Object Mapper
function getSheetDataAsObjects(sheet) {
  if (!sheet) return [];
  var data = sheet.getDataRange().getValues();
  if (data.length <= 1) return [];

  var headers = data[0];
  var result = [];

  for (var i = 1; i < data.length; i++) {
    var row = data[i];
    var obj = {};
    for (var j = 0; j < headers.length; j++) {
      obj[headers[j]] = row[j];
    }
    result.push(obj);
  }
  return result;
}

function returnJSON(obj) {
  return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON);
}
